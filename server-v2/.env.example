# ─────────────────────────────────────────────────────────
# ReachPilot Backend — Environment Variables
# Copy to .env and fill in values before starting.
# ─────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string. The docker-compose default:
DATABASE_URL=postgresql://reachpilot:reachpilot@localhost:5432/reachpilot

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────
# Allowed origin for the Vite dev server
CORS_ORIGIN=http://localhost:5173

# ── Auth — JWT ────────────────────────────────────────────
# HS256 secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-jwt-secret-at-least-64-chars-long-abc123def456ghi789
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-64-chars-long-abc123def456ghi789
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Auth — dev bypass ────────────────────────────────────
# When true, a default user + workspace are auto-provisioned
# on first request so the unmodified frontend can complete
# its onboarding flow without a real login/signup screen.
# NEVER enable in production.
AUTH_BYPASS=true

# ── Auth — Google OAuth (optional) ────────────────────────
# Leave empty to disable Google Sign-In.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Encryption vault ──────────────────────────────────────
# 32-byte hex master key for envelope encryption (local KMS stand-in).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Mail (MailHog for dev) ────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@reachpilot.dev

# ── Rate limiting ─────────────────────────────────────────
# Max requests per window (per IP) for auth endpoints
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=60000

# Max requests per window for send endpoints
RATE_LIMIT_SEND_MAX=10
RATE_LIMIT_SEND_WINDOW_MS=60000

# ── LinkedIn automation driver ────────────────────────────
# 'simulator' = fake driver (no real LinkedIn contact, safe for dev/tests).
# 'playwright' = real headless-browser automation (needs proxies + browsers:
#   run `npx playwright install chromium` once).
LINKEDIN_DRIVER=simulator
# Run the browser headless (true) or visible for debugging (false).
PLAYWRIGHT_HEADLESS=true
# Slow every action by N ms (0 = off) — useful when watching a debug run.
PLAYWRIGHT_SLOWMO_MS=0

# ── Proxies (required for real 'playwright' mode) ─────────
# One dedicated, country-matched residential/mobile IP per account.
# Option A — a provider gateway (e.g. Bright Data): set server + creds.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
# Option B — leave PROXY_SERVER empty and store per-account IPs in the
# `proxies` table (assigned at connect time by ProxiesService).

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=debug
