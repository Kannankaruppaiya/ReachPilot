{
  "name": "reachpilot-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ReachPilot production backend — NestJS API + BullMQ workers",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:api": "ts-node -r tsconfig-paths/register src/main.ts",
    "start:api:dev": "ts-node-dev --respawn -r tsconfig-paths/register src/main.ts",
    "start:worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "start:worker:dev": "ts-node-dev --respawn -r tsconfig-paths/register src/worker.ts",
    "start:scraper": "ts-node -r tsconfig-paths/register src/scraper-service.ts",
    "spike:crawlee": "ts-node -r tsconfig-paths/register scripts/spike-crawlee.ts",
    "test:m2": "ts-node -r tsconfig-paths/register scripts/test-m2-cursor.ts",
    "test:100": "ts-node -r tsconfig-paths/register scripts/test-100-leads.ts",
    "test:multi": "ts-node -r tsconfig-paths/register scripts/test-multi-engine.ts",
    "start:scraper:dev": "ts-node-dev --respawn -r tsconfig-paths/register src/scraper-service.ts",
    "migrate": "ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "seed": "ts-node -r tsconfig-paths/register scripts/seed.ts",
    "connect": "ts-node -r tsconfig-paths/register scripts/auto-connect.ts",
    "verify:connect": "ts-node -r tsconfig-paths/register scripts/verify-connect-e2e.ts",
    "codegen": "kysely-codegen --out-file src/db/types.ts --dialect postgres",
    "test": "jest --runInBand --forceExit",
    "test:cov": "jest --runInBand --forceExit --coverage",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.30.1",
    "crawlee": "^3.17.0",
    "dotenv": "^16.4.7",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "kysely": "^0.27.6",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "patchright": "^1.61.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.61.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.12.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.16.8",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
